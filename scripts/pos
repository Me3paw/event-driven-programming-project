#!/usr/bin/env bash
set -euo pipefail

root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
project_name=pos-nature-crud
tools_dir="$root_dir/.tools"
jdk_dir="$tools_dir/temurin-8"
jdk_archive="$tools_dir/OpenJDK8U-jdk_x64_linux_hotspot_8u472b08.tar.gz"
jdk_url=https://github.com/adoptium/temurin8-binaries/releases/download/jdk8u472-b08/OpenJDK8U-jdk_x64_linux_hotspot_8u472b08.tar.gz
jdk_sha256=5becaa4ac660e844c5a39e2ebc39ff5ac824c37ff1b625af8c8b111dc13c3592
maven_image=maven:3.9.11-eclipse-temurin-8
jar_path="$root_dir/target/pos-nature-crud-0.1.0-all.jar"

die() { echo "error: $*" >&2; exit 1; }

compose() {
  local env_file=$root_dir/.env
  [ -f "$env_file" ] || env_file=$root_dir/.env.example
  docker compose --project-name "$project_name" --project-directory "$root_dir" --env-file "$env_file" "$@"
}

need_env() {
  [ -f "$root_dir/.env" ] || die "missing .env; run '$0 setup' first"
}

env_value() {
  local name=$1 default_value=$2 value
  value=$(sed -n "s/^${name}=//p" "$root_dir/.env" | tail -n 1)
  printf '%s' "${value:-$default_value}"
}

export_db_env() {
  need_env
  export POS_DB_URL="$(env_value POS_DB_URL jdbc:mariadb://127.0.0.1:3307/pos_nature)"
  export POS_DB_USER="$(env_value POS_DB_USER pos_app)"
  export POS_DB_PASSWORD="$(env_value POS_DB_PASSWORD '')"
  [ -n "$POS_DB_PASSWORD" ] || die "POS_DB_PASSWORD is empty in .env"
}

need_jdk() {
  [ -x "$jdk_dir/bin/java" ] || die "local Java 8 missing; run '$0 setup' first"
  "$jdk_dir/bin/java" -version 2>&1 | grep -q '1\.8\.' || die "local runtime is not Java 8"
}

port_free() {
  ! ss -ltnH 'sport = :3307' | grep -q .
}

setup() {
  mkdir -p "$tools_dir"
  if [ ! -f "$root_dir/.env" ]; then
    cp "$root_dir/.env.example" "$root_dir/.env"
    chmod 600 "$root_dir/.env"
    echo "Created local .env from .env.example."
  fi
  if [ ! -x "$jdk_dir/bin/java" ]; then
    command -v curl >/dev/null || die "curl is required to download the local JDK"
    command -v sha256sum >/dev/null || die "sha256sum is required to verify the local JDK"
    command -v tar >/dev/null || die "tar is required to unpack the local JDK"
    curl --fail --location --output "$jdk_archive" "$jdk_url"
    echo "$jdk_sha256  $jdk_archive" | sha256sum --check --status || die "Temurin JDK checksum mismatch"
    temp_dir=$(mktemp -d "$tools_dir/.temurin-8.XXXXXX")
    tar -xzf "$jdk_archive" --strip-components=1 -C "$temp_dir"
    rm -rf "$jdk_dir"
    mv "$temp_dir" "$jdk_dir"
    printf 'Temurin 8u472-b08\nSHA-256: %s\nSource: %s\n' "$jdk_sha256" "$jdk_url" > "$tools_dir/temurin-8.txt"
  fi
  need_jdk
  "$jdk_dir/bin/java" -version
}

build() {
  mkdir -p "$root_dir/.m2/repository"
  docker run --rm \
    --user "$(id -u):$(id -g)" \
    --env HOME=/workspace \
    --env MAVEN_CONFIG=/workspace/.m2 \
    --volume "$root_dir:/workspace" \
    --workdir /workspace \
    "$maven_image" mvn --batch-mode -Dmaven.repo.local=/workspace/.m2/repository -DskipTests clean package
}

db_up() {
  need_env
  existing_container=$(compose ps -q mariadb)
  [ -n "$existing_container" ] || port_free || die "127.0.0.1:3307 is already in use; refusing to start MariaDB"
  compose up -d
  container_id=$(compose ps -q mariadb)
  [ -n "$container_id" ] || die "MariaDB container was not created"
  for attempt in $(seq 1 30); do
    health=$(docker inspect --format '{{.State.Health.Status}}' "$container_id")
    [ "$health" = healthy ] && break
    [ "$health" != unhealthy ] || die "MariaDB became unhealthy"
    sleep 1
  done
  [ "${health:-}" = healthy ] || die "MariaDB did not become healthy within 30 seconds"
  compose ps
}

db_down() {
  need_env
  compose down
}

run_app() {
  need_jdk
  [ -f "$jar_path" ] || die "missing packaged JAR; run '$0 build' first"
  "$jdk_dir/bin/java" -jar "$jar_path"
}

smoke() {
  need_jdk
  [ -f "$jar_path" ] || die "missing packaged JAR; run '$0 build' first"
  export_db_env
  "$jdk_dir/bin/java" -jar "$jar_path" --db-smoke
}

package_release() {
  build
  mkdir -p "$root_dir/dist"
  cp "$jar_path" "$root_dir/dist/pos-nature-crud-0.1.0.jar"
  (cd "$root_dir/dist" && sha256sum pos-nature-crud-0.1.0.jar > pos-nature-crud-0.1.0.jar.sha256)
  cp "$root_dir/RELEASE_NOTES.md" "$root_dir/dist/RELEASE_NOTES.md"
}

purge() {
  [ "${2:-}" = "--yes" ] || die "refusing cleanup without: $0 purge --yes"
  compose down --volumes --remove-orphans
  rm -rf "$root_dir/.tools" "$root_dir/.m2" "$root_dir/target" "$root_dir/dist"
}

case "${1:-}" in
  setup) setup ;;
  build) build ;;
  db-up) db_up ;;
  db-down) db_down ;;
  status) need_env; compose ps ;;
  run) run_app ;;
  smoke) smoke ;;
  package) package_release ;;
  purge) purge "$@" ;;
  *)
    echo "Usage: $0 {setup|build|db-up|db-down|status|run|smoke|package|purge --yes}" >&2
    exit 64
    ;;
esac
