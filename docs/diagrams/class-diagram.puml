  class DoanhThuTheoNgay
  class DoanhSoSanPham
  class SanPhamSapHetHang
  class SoLuongTheoHangThanhVien
  class HoSoKhachHang
  class DongThanhToan
  class YeuCauThanhToan
  class BaoGia
}

