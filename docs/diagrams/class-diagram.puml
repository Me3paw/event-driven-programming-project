  class NhanVienPanel
  class NhaCungCapPanel
}

package components {
  class BarChart
  class DialogActions
  class ReceiptPrintable
  class ReceiptPrinting
  class UiTheme
}

package service {
  class KiemTraQuyen
  class GiaoDichPhien
  class DauVanThanhToan
  class NguoiDung {
    +getTenDangNhap(): String
    +getMaNhanVien(): String
    +getVaiTro(): String
    +isQuanLy(): boolean
  }
  class DichVuDangNhap {
    +dangNhapNguoiDung(tenDangNhap: String, matKhau: char[]): NguoiDung
  }
  class DichVuDanhMuc {
    +luuNhanVien(actor: NguoiDung, value: NhanVien): void
    +luuTaiKhoan(actor: NguoiDung, value: TaiKhoan, password: char[]): void
    +luuLoai(actor: NguoiDung, value: LoaiSanPham): void
    +luuSanPham(actor: NguoiDung, value: SanPham): void
    +luuKhachHang(actor: NguoiDung, value: KhachHang): void
    +luuNhaCungCap(actor: NguoiDung, value: NhaCungCap): void
    +timNhanVien(actor: NguoiDung, keyword: String, state: String): List<NhanVien>
    +timTaiKhoan(actor: NguoiDung, keyword: String, role: String, state: String): List<TaiKhoan>
    +timLoai(actor: NguoiDung, keyword: String): List<LoaiSanPham>
    +timSanPham(actor: NguoiDung, keyword: String, category: String, state: String, minPrice: BigDecimal, maxPrice: BigDecimal): List<SanPham>
    +timKhachHang(actor: NguoiDung, keyword: String, state: String): List<KhachHang>
    +chiTietKhachHang(actor: NguoiDung, id: String): HoSoKhachHang
    +khachHangTheoHang(actor: NguoiDung, tier: String): List<KhachHang>
    +timNhaCungCap(actor: NguoiDung, keyword: String): List<NhaCungCap>
    +xoaNhanVien(actor: NguoiDung, id: String): void
    +xoaTaiKhoan(actor: NguoiDung, id: String): void
    +xoaLoai(actor: NguoiDung, id: String): void
    +xoaSanPham(actor: NguoiDung, id: String): void
    +xoaKhachHang(actor: NguoiDung, id: String): void
    +xoaNhaCungCap(actor: NguoiDung, id: String): void
    +capNhatTrangThaiNhanVien(actor: NguoiDung, id: String, state: String): void
    +capNhatTrangThaiTaiKhoan(actor: NguoiDung, id: String, state: String): void
  }
  class DichVuNhapHang {
    +luuNhap(actor: NguoiDung, value: PhieuNhap): void
    +tim(actor: NguoiDung, keyword: String, state: String): List<PhieuNhap>
    +chiTiet(actor: NguoiDung, id: String): PhieuNhap
    +hoanTat(actor: NguoiDung, id: String): void
    +xoaNhap(actor: NguoiDung, id: String): void
    +capNhatChiTiet(actor: NguoiDung, id: String, lines: List<ChiTietPhieuNhap>): void
  }
  class DichVuTonKho {
    +tonKho(actor: NguoiDung, keyword: String): List<LoTonKho>
    +giamTonFifo(actor: NguoiDung, id: String, product: String, amount: int, reason: String): void
    +timDieuChinh(actor: NguoiDung, keyword: String): List<DieuChinhTon>
    +chiTietDieuChinh(actor: NguoiDung, id: String): DieuChinhTon
  }
  class DichVuKhuyenMai {
    +tim(actor: NguoiDung, keyword: String, state: String): List<KhuyenMai>
    +capNhatTrangThai(actor: NguoiDung, id: String, state: String): void
    +xoa(actor: NguoiDung, id: String): void
    +luu(actor: NguoiDung, value: KhuyenMai): void
  }
  class DichVuBanHang {
    +maHoaDonTiepTheo(actor: NguoiDung): String
    +baoGia(actor: NguoiDung, request: YeuCauThanhToan): BaoGia
    +thanhToan(actor: NguoiDung, request: YeuCauThanhToan): HoaDon
    +khuyenMaiHieuLuc(actor: NguoiDung, products: Set<String>, time: LocalDateTime): List<KhuyenMai>
    +huyHoaDon(actor: NguoiDung, id: String, reason: String, manager: String, password: char[]): void
    +timHoaDon(actor: NguoiDung, keyword: String, employee: String, state: String): List<HoaDon>
    +timHoaDon(actor: NguoiDung, keyword: String, employee: String, customer: String, state: String, method: String, from: LocalDate, to: LocalDate): List<HoaDon>
    +chiTietHoaDon(actor: NguoiDung, id: String): HoaDon
  }
  class DichVuBaoCao {
    +tongHop(actor: NguoiDung, from: LocalDate, to: LocalDate): TongHopBaoCao
    +doanhThuTheoNgay(actor: NguoiDung, from: LocalDate, to: LocalDate): List<DoanhThuTheoNgay>
    +sanPhamBanChay(actor: NguoiDung, from: LocalDate, to: LocalDate): List<DoanhSoSanPham>
    +sanPhamSapHetHang(actor: NguoiDung): List<SanPhamSapHetHang>
    +soLuongTheoHangThanhVien(actor: NguoiDung): List<SoLuongTheoHangThanhVien>
    +khachHangTheoHang(actor: NguoiDung, tier: String): List<KhachHang>
  }
  class DichVuCauHinh {
    +lay(actor: NguoiDung): CauHinhCuaHang
    +layChoHoaDon(actor: NguoiDung): CauHinhCuaHang
    +luu(actor: NguoiDung, value: CauHinhCuaHang): void
  }
